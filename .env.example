# Copy to .env.local. Never commit real values.

# Supabase project URL and anon key (safe for the browser, protected by row-level security)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix with NEXT_PUBLIC_. On Vercel, add it as a server environment variable.
SUPABASE_SERVICE_ROLE_KEY=
